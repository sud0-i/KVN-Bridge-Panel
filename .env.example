# Скопируйте в .env и заполните. Файл .env не коммитится.
DOMAIN=panel.example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=generate-32-random-chars
# Секретный путь панели: https://$DOMAIN/<ADMIN_PATH>/ (8–64 символа: латиница, цифры, - и _).
# По https://$DOMAIN открывается заглушка или ваш сайт из data/site. Пусто — панель в корне.
ADMIN_PATH=generate-24-random-chars
# Необязательно: адрес мастера для агентов (по умолчанию https://$DOMAIN)
# MASTER_URL=https://panel.example.com
# Необязательно: SNI для Reality по умолчанию
# DEFAULT_SNI=www.microsoft.com
# Необязательно: начальный список «напрямую с мостов» (через запятую).
# Дальше маршрутизация настраивается в панели, вкладка «Маршрутизация». Пример:
# BRIDGE_DIRECT=geosite:private,domain:example.com
